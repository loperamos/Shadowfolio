# Copy to .env and adjust. .env is gitignored; never commit secrets.

# Which wiring to run: local (your machine). production comes with hosting.
SHADOWFOLIO_ENV=local

# Path to the SQLite database file (local). Relative paths are relative to this file's folder.
SHADOWFOLIO_DB=data/shadowfolio.db

# Alpaca market data, free plan (local). Keys from https://app.alpaca.markets → API keys.
# Development only: Alpaca's license forbids showing its data to public users.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Optional: who SEC EDGAR (company fundamentals) is told is asking, as it requires: an app name and a contact email,
# e.g. "Shadowfolio you@example.com". Without it, security pages show no fundamentals.
SEC_EDGAR_CONTACT=

# Optional: Finnhub API key, for when companies report results next (free tier, https://finnhub.io → Dashboard).
# Development only until its terms are confirmed; without it, security pages show no earnings date.
FINNHUB_API_KEY=

# Sign-in, through Auth0 (https://manage.auth0.com). None of these is a secret: a single-page app has no client
# secret, and the backend only checks tokens against Auth0's public keys. The frontend gets them from the backend.
# - AUTH0_DOMAIN: your tenant's domain, e.g. your-tenant.eu.auth0.com
# - AUTH0_CLIENT_ID: the Single Page Application's client id (Applications → your app → Settings)
# - AUTH0_AUDIENCE: the API's identifier (Applications → APIs → your API), e.g. https://shadowfolio/api
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=
# Who the wallets made before sign-in existed belong to: your user id as Auth0 gives it (e.g. auth0|64f…, shown in
# the app once you sign in). Empty: they stay unowned until set.
SHADOWFOLIO_EXISTING_WALLETS_OWNER=

# Self-hosting with Docker (docker compose up -d, see the README): the Cloudflare Tunnel token that publishes the app
# on your domain (Zero Trust → Networks → Tunnels → your tunnel). A secret: never commit or share it.
CLOUDFLARE_TUNNEL_TOKEN=

# Address the API listens on. Use 0.0.0.0 to reach it from other machines on your network.
# The MCP server (/mcp) only answers requests addressed to localhost, against DNS rebinding: to reach it from another
# machine, list the addresses it uses, comma-separated, e.g. 192.168.1.75:8000 (a port of * allows any).
SHADOWFOLIO_HOST=127.0.0.1
SHADOWFOLIO_PORT=8000
SHADOWFOLIO_MCP_ALLOWED_HOSTS=
