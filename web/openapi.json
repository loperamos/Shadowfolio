          },
          {
            "name": "operation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Operation Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/DepositEdit"
                  },
                  {
                    "$ref": "#/components/schemas/WithdrawalEdit"
                  },
                  {
                    "$ref": "#/components/schemas/BuyEdit"
                  },
                  {
                    "$ref": "#/components/schemas/SellEdit"
                  }
                ],
                "discriminator": {
                  "propertyName": "type",
                  "mapping": {
                    "deposit": "#/components/schemas/DepositEdit",
                    "withdrawal": "#/components/schemas/WithdrawalEdit",
                    "buy": "#/components/schemas/BuyEdit",
                    "sell": "#/components/schemas/SellEdit"
                  }
                },
                "title": "Request"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalletResponse"
                }
              }
            }
