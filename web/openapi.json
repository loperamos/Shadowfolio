  "components": {
    "schemas": {
      "BuyEdit": {
        "properties": {
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "quantity": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "title": "Quantity"
          },
          "price": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "title": "Price"
          },
          "price_currency": {
            "$ref": "#/components/schemas/Currency"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "settled_amount": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Settled Amount"
          },
          "fees": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "title": "Fees",
            "default": "0"
          },
          "type": {
            "type": "string",
            "const": "buy",
            "title": "Type"
          }
        },
        "type": "object",
        "required": [
          "symbol",
          "quantity",
          "price",
          "price_currency",
          "timestamp",
          "type"
        ],
        "title": "BuyEdit"
      },
      "CashMovementRequest": {
        "properties": {
          "amount": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "title": "Amount"
          },
          "timestamp": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "amount"
        ],
        "title": "CashMovementRequest",
        "description": "A deposit or a withdrawal."
      },
      "CopyWalletRequest": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "CopyWalletRequest"
      },
      "CreateWalletRequest": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "currency": {
            "$ref": "#/components/schemas/Currency"
          },
          "cash": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "title": "Cash"
          }
        },
        "type": "object",
        "required": [
          "name",
          "currency",
          "cash"
        ],
        "title": "CreateWalletRequest"
      },
      "Currency": {
        "type": "string",
        "enum": [
          "USD",
          "EUR"
        ],
        "title": "Currency"
      },
      "DepositEdit": {
        "properties": {
          "amount": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "title": "Amount"
          },
          "timestamp": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timestamp"
          },
          "type": {
            "type": "string",
            "const": "deposit",
            "title": "Type"
          }
        },
        "type": "object",
        "required": [
          "amount",
          "type"
        ],
        "title": "DepositEdit"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              }
            ],
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "FieldError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Loc"
          },
          "msg": {
            "type": "string",
            "title": "Msg"
          },
          "type": {
            "type": "string",
            "title": "Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "FieldError",
        "description": "One problem in a malformed request, as FastAPI reports it."
      },
      "FxRateResponse": {
        "properties": {
          "rate": {
            "type": "string",
            "title": "Rate"
          },
          "as_of": {
            "type": "string",
            "format": "date",
            "title": "As Of"
          }
        },
        "type": "object",
        "required": [
          "rate",
          "as_of"
        ],
        "title": "FxRateResponse"
      },
      "HoldingValueResponse": {
        "properties": {
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "quantity": {
            "type": "string",
            "title": "Quantity"
          },
          "price": {
            "type": "string",
            "title": "Price"
